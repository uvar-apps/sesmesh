# Environment for the cross-tool comparison (GitHub issues #5, #6).
# Base layer only: system packages, Rust, ChimeraX and the prebuilt binaries.
# Programs built from source (sesmesh, NanoShaper, ESES) are compiled by
# build-tools.sh into the mounted work directory, so they can be rebuilt
# without rebuilding the image. See tools/compare/README.md.
#
# Build context: the bench work directory, with the downloads in dl/:
#   podman build -t sesmesh-compare -f Containerfile ~/sesmesh-bench

FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive TZ=UTC LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake git curl ca-certificates pkg-config file \
        xz-utils unzip patch \
        libcgal-dev libgmp-dev libmpfr-dev \
        libboost-dev libboost-thread-dev libboost-system-dev \
        libomp-dev clang \
        edtsurf time hyperfine \
        python3 python3-venv python3-numpy python3-scipy python3-networkx \
        libgl1 libegl1 libglu1-mesa libxkbcommon0 libfontconfig1 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*

# Independent mesh checks (watertightness, orientation, volume).
RUN python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir 'trimesh>=4.4,<5'

# Rust toolchain for sesmesh (MSRV 1.89).
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
        --default-toolchain 1.99.0 --no-modify-path
ENV PATH=/opt/venv/bin:/opt/cargo/bin:$PATH

# UCSF ChimeraX 1.12 (non-commercial licence accepted at download).
COPY dl/ucsf-chimerax_1.12ubuntu24.04_amd64.deb /tmp/
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/ucsf-chimerax_1.12ubuntu24.04_amd64.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/*.deb

# MSMS 2.6.2 (Sanner lab, non-commercial licence), static build.
COPY dl/msms_i86_64Linux2_2.6.2.tar.gz /tmp/
RUN mkdir -p /opt/msms && tar xzf /tmp/msms_i86_64Linux2_2.6.2.tar.gz -C /opt/msms --strip-components=1 \
    && ln -s /opt/msms/msms.x86_64Linux2.2.6.2.staticgcc /usr/local/bin/msms \
    && rm /tmp/msms_*.tar.gz

# sesa V001 and sesx V002 (L. Wang, GPL-3), prebuilt Linux binaries.
COPY dl/sesaV001.tar.gz dl/sesxV002_linux.tar.gz /tmp/
RUN tar xzf /tmp/sesaV001.tar.gz -C /opt && tar xzf /tmp/sesxV002_linux.tar.gz -C /opt \
    && rm /tmp/ses*.tar.gz

WORKDIR /work
