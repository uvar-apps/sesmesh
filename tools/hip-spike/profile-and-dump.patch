+/// TEMPORARY: appends one sub-block (candidates, samples, CPU values) to
+/// `$SESMESH_DUMP` for the HIP spike.
+#[allow(clippy::too_many_arguments)]
+fn dump_subblock(g: &Gathered, m: usize, xs: &[f32], ys: &[f32], zs: &[f32], out: &[f32], probe: f32, cutoff2: f32) {
+    use std::io::Write;
+    static FILE: std::sync::OnceLock<Option<std::sync::Mutex<std::fs::File>>> = std::sync::OnceLock::new();
+    let f = FILE.get_or_init(|| std::env::var_os("SESMESH_DUMP").map(|p| std::sync::Mutex::new(std::fs::File::create(p).unwrap())));
+    let Some(f) = f else { return };
+    let mut b: Vec<u8> = Vec::new();
+    let u = |b: &mut Vec<u8>, v: u32| b.extend_from_slice(&v.to_le_bytes());
+    let fl = |b: &mut Vec<u8>, v: &[f32]| for x in v { b.extend_from_slice(&x.to_le_bytes()); };
+    let us = |b: &mut Vec<u8>, v: &[u32]| for x in v { b.extend_from_slice(&x.to_le_bytes()); };
+    for v in [m, g.n_inside, g.nx.len(), g.sx.len(), g.s_blk.len(), g.cx.len(), g.c_blk.len(), g.vx.len()] { u(&mut b, v as u32); }
+    fl(&mut b, &[probe, cutoff2]);
+    fl(&mut b, &xs[..m]); fl(&mut b, &ys[..m]); fl(&mut b, &zs[..m]);
+    for v in [&g.nx, &g.ny, &g.nz, &g.nr2, &g.nr2tol] { fl(&mut b, v); }
+    for v in [&g.sx, &g.sy, &g.sz, &g.sr] { fl(&mut b, v); }
+    us(&mut b, &g.s_off); us(&mut b, &g.s_blk);
+    for v in [&g.cx, &g.cy, &g.cz, &g.ux, &g.uy, &g.uz, &g.ex, &g.ey, &g.ez, &g.rho] { fl(&mut b, v); }
+    us(&mut b, &g.c_off); us(&mut b, &g.c_blk);
+    for v in [&g.vx, &g.vy, &g.vz] { fl(&mut b, v); }
+    fl(&mut b, &out[..m]);
+    f.lock().unwrap().write_all(&b).unwrap();
+}
