+// sesmesh — Solvent Excluded Surface meshes for molecules
+// Copyright (c) 2026 Ugo Varetto
+// SPDX-License-Identifier: MIT OR Apache-2.0
+#![allow(missing_docs, clippy::all, clippy::pedantic)]
+//! TEMPORARY profiling counters (not for commit).
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+pub static C: [AtomicU64; 24] = [const { AtomicU64::new(0) }; 24];
+pub const NAMES: [&str; 24] = ["subclass_ns","gather_ns","kernel_ns","coords_ns","lgather_ns","vertex_ns","cells_ns","bricks","subblocks","samples_active","samples_padded","n_inside","n_near","n_s","n_sblk","n_c","n_cblk","n_v","vertices","evals_unused","signonly","lsub","edges_loop_ns","x"];
+#[inline] pub fn add(i: usize, v: u64) { C[i].fetch_add(v, Relaxed); }
+pub fn report() { for (i,n) in NAMES.iter().enumerate() { let v=C[i].swap(0,Relaxed); if v>0 { std::eprintln!("PROF {n} {v}"); } } }
